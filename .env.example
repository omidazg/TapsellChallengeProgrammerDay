# Copy to .env and fill in real values before deploying.
# Locally, DATABASE_URL points at a file next to the project;
# in Docker Compose it is overridden to file:/app/data/dev.db
# (see docker-compose.yml), so leave it as-is here.
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Comma-separated list of allowed email domains for signup, e.g.
# "tapsell.ir,example.com". Empty = no restriction.
ALLOWED_EMAIL_DOMAINS=""

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Set to "true" once the site is served over HTTPS (it is, once a
# real domain is set in SITE_ADDRESS and Caddy issues a certificate).
COOKIE_SECURE="false"

ADMIN_EMAIL="admin@tapsell.ir"
ADMIN_PASSWORD=""

# Directory where uploaded/optimized images are stored. Leave unset to use
# the default (./data/uploads locally, /app/data/uploads in Docker — see
# docker-compose.yml, which sets it explicitly for the `web` service).
UPLOAD_DIR=""

# Caddy listen address. Use ":80" for plain HTTP with no domain, or
# "example.com" (no scheme) for automatic HTTPS via Let's Encrypt.
SITE_ADDRESS=":80"

# VAPID keys for Web Push (browser push notifications). Generate once with:
#   npx web-push generate-vapid-keys
# and paste the two resulting values below. Leave empty to disable push
# (the /notifications toggle then shows "not configured" instead of erroring).
# Push also requires HTTPS in the browser — on a plain-HTTP IP deployment,
# the toggle will show the "needs HTTPS" message regardless of these keys.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Contact for the VAPID JWT, shown to push services if something goes wrong.
# Must be a "mailto:" address or an "https:" URL.
VAPID_SUBJECT="mailto:admin@tapsell.ir"

# ---------------------------------------------------------------------------
# Rate limiting (src/lib/rate-limit.ts)
# ---------------------------------------------------------------------------
# On event day everyone shares one public IP (venue NAT), so the per-IP caps
# are deliberately high and only FAILED logins are counted. The real
# brute-force protection is the per-email cap. Raise these if the venue
# network is larger than expected; all are per sliding window.
LOGIN_IP_RATE="100"        # failed logins per IP / 10 min
LOGIN_EMAIL_RATE="8"       # failed logins per email / 10 min
REGISTER_IP_RATE="150"     # registrations per IP / 1 hour
ASSISTANT_IP_RATE="200"    # AI assistant questions per IP / 1 min

# ---------------------------------------------------------------------------
# AI cost control (src/lib/ai-budget.ts)
# ---------------------------------------------------------------------------
# Daily spend ceiling in USD across all AI features (Tehran day boundary).
# When it is reached, AI calls stop and the UI shows the "unavailable" state.
AI_DAILY_BUDGET_USD="20"
# Per-user daily message cap for the AI analyst chat.
AI_USER_DAILY_MESSAGES="30"

# ---------------------------------------------------------------------------
# Alerting and health (src/lib/alert.ts, src/app/api/health/route.ts)
# ---------------------------------------------------------------------------
# Optional. A generic webhook (Slack/Discord/etc.) that receives error alerts.
ALERT_WEBHOOK_URL=""
# Optional Telegram alerting. TELEGRAM_API_BASE lets you point at a proxy,
# since api.telegram.org is not reachable from Iran without one.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_BASE="https://api.telegram.org"
# Shown by /api/health so you can tell which commit is live. deploy.sh can
# set this; leave empty locally.
GIT_SHA=""

# ---------------------------------------------------------------------------
# Backups (scripts/backup.mjs, the `backup` service in docker-compose.yml)
# ---------------------------------------------------------------------------
BACKUP_DIR="/backups"
BACKUP_INTERVAL_MIN="15"
BACKUP_KEEP="96"           # keep the last N interval backups + 1/day for 14 days

# ---------------------------------------------------------------------------
# Dangerous operations
# ---------------------------------------------------------------------------
# scripts/reset-game.ts wipes ALL game-round data. It refuses to run when
# NODE_ENV=production unless this is set to "1". Leave empty.
ALLOW_RESET=""
