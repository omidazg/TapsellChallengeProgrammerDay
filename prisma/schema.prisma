// میدان بنیان‌گذاران تپسل — مدل داده
// SQLite برای سادگی استقرار؛ برای ~۱۰۰ کاربر کافی است.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------- کاربر و تیم ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique // موبایل ۰۹xxxxxxxxx برای ورود با کد پیامکی
  passwordHash String
  nickname     String
  role         String // مهارت اصلی (فقط برچسب پروفایل): BUILDER | STORYTELLER | DEALMAKER
  // قدرت‌های ویژه از بازی حذف شده‌اند؛ این سه ستون فقط برای سازگاری با داده‌های قدیمی مانده‌اند.
  power        String // کاربران تازه: ""
  powerUsed    Boolean  @default(false)
  shieldTeamId String?
  coffee       Int      @default(5)
  bugs         Int      @default(50)
  sleep        Int      @default(7)
  confidence   Int      @default(100)
  avatarSeed   String   @default("")
  isAdmin      Boolean  @default(false)
  // نقش محدود در پنل: "" | JUDGE (فقط داوری) | STUDIO_OP (فقط بازار استودیو و آمار بازار)
  staffRole    String   @default("")
  department   String   @default("")
  createdAt    DateTime @default(now())

  // با هر بازنشانی رمز یا مسدودسازی یک واحد بالا می‌رود تا نشست‌های قدیمی باطل شوند
  sessionVersion Int       @default(0)
  blockedAt      DateTime?

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  seedWallet Int @default(100) // قدیمی (کیف بذر)؛ همه‌چیز حالا با یک کیف سکه است (ثبت‌نام ۰ می‌گذارد)
  buyWallet  Int @default(100) // کیف سکه (سکهٔ رایگان اولیه از starting_coins + سکهٔ خریداری‌شده)

  investments       Investment[]
  purchases         Purchase[]
  bids              Bid[]
  hearts            Heart[]
  ledger            LedgerEntry[]
  invitesSent       TeamInvite[]          @relation("inviter")
  chats             DueDiligenceMessage[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]
  surveyResponse    SurveyResponse?
  coinOrders        CoinOrder[]
  juryScores        JuryScore[]

  @@index([teamId])
}

model Team {
  id              String          @id @default(cuid())
  name            String          @unique
  slug            String          @unique
  // توکن تصادفی لینک دعوت (/join/<token>)؛ اسلاگ عمومی است و برای پیوستن کافی نیست.
  // فقط به اعضای خود تیم نشان داده می‌شود و اعضا می‌توانند آن را عوض کنند.
  inviteToken     String?         @unique @default(uuid())
  logoSeed        String          @default("")
  treasury        Int             @default(0) // قدیمی (خزانهٔ تیم)؛ دیگر استفاده نمی‌شود
  // قدیمی: رأی‌گیری سرپرست حذف شده و همهٔ اعضا کارهای تیم را انجام می‌دهند
  leaderId        String?
  leaderElectedAt DateTime?
  // کسر امتیاز تقلب (با تأیید برگزارکننده) و توضیح آن برای تیم
  cheatPenalty    Int             @default(0)
  cheatNote       String          @default("")
  // شرکت فردی: تیم یک‌نفره‌ای که عضو تازه نمی‌پذیرد (هم‌تیم‌سازی خودکار و لینک دعوت به آن نمی‌رسند)
  solo            Boolean         @default(false)
  createdAt       DateTime        @default(now())
  members         User[]
  ideas           Idea[]
  products        Product[]
  invites         TeamInvite[]
  adSlotBids      AdSlotBid[]
  scores          TeamScore[]
  flags           CollusionFlag[]
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  email     String
  inviterId String
  inviter   User     @relation("inviter", fields: [inviterId], references: [id])
  status    String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt DateTime @default(now())

  @@index([email, status])
  @@index([teamId])
}

// ---------- ایده و سرمایه‌گذاری ----------

// ---------- محورهای مسابقه ----------

// هر تیم در هر محور حداکثر یک ایده و یک محصول دارد. شناسهٔ سه محور پیش‌فرض در مهاجرت ساخته می‌شود.
model Track {
  id           String    @id // general | content | os | ...
  name         String
  description  String    @default("")
  kind         String    @default("PRODUCT") // PRODUCT | CONTENT | OS (نوع فرم ارسال)
  category     String    @default("MIXED") // TECH | NON_TECH | MIXED (در MIXED هر محصول دستهٔ خودش را انتخاب می‌کند)
  status       String    @default("open") // open | ro | closed | hidden
  order        Int       @default(0)
  weights      String    @default("{}") // JSON: TrackWeights
  juryCriteria String    @default("[]") // JSON: [{key, label}]
  aiRubric     String    @default("") // JSON: پارامترهایی که هوش مصنوعی برای امتیاز نهایی همین محور تعیین کرده
  createdAt    DateTime  @default(now())
  ideas        Idea[]
  products     Product[]
  prizes       Prize[]
  scores       TeamScore[]
}

// ایشوهای محور «راهکار OS»؛ اگر فهرستی نباشد تیم مسئله را خودش تعریف می‌کند.
model OsIssue {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  url         String    @default("")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

// استثنای وضعیت یک بخش برای یک تیم (مثلاً بازکردن ثبت محصول فقط برای یک تیم)
model ModuleException {
  id        String   @id @default(cuid())
  moduleKey String
  teamId    String
  createdBy String
  createdAt DateTime @default(now())

  @@unique([moduleKey, teamId])
  @@index([teamId])
}

model Idea {
  id                 String                @id @default(cuid())
  teamId             String
  team               Team                  @relation(fields: [teamId], references: [id])
  trackId            String                @default("general")
  track              Track                 @relation(fields: [trackId], references: [id])
  title              String
  oneLiner           String
  problem            String
  audience           String
  buildPlan          String // چه چیزی در ۴۸ ساعت ساخته می‌شود
  coverUrl           String                @default("")
  fundingCap         Int // قدیمی (هدف جذب سرمایه)؛ ایده‌های تازه ۰
  revenueShare       Int // قدیمی (درصد سود سرمایه‌گذار)؛ ایده‌های تازه ۰
  analystClarity     Int? // ۰..۱۰۰
  analystFeasibility Int?
  analystNovelty     Int?
  analystSummary     String? // متن فارسی تحلیل‌گر (برای حامی‌ها)
  analystAdvice      String? // پیشنهاد تحلیل‌گر به خود تیم برای بهترکردن ایده
  editedAt           DateTime? // آخرین تغییر محتوا پس از ثبت نهایی (حامی‌های قبلی می‌توانند حمایتشان را پس بگیرند)
  submittedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  investments        Investment[]
  chats              DueDiligenceMessage[]
  revisions          IdeaRevision[]

  @@unique([teamId, trackId])
  @@index([trackId])
}

// تاریخچهٔ تغییرات ایده پس از ثبت نهایی (نسخهٔ قبل از هر ویرایش)
model IdeaRevision {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id])
  title     String
  oneLiner  String
  problem   String
  audience  String
  buildPlan String
  createdAt DateTime @default(now())

  @@index([ideaId])
}

model Investment {
  id         String   @id @default(cuid())
  ideaId     String
  idea       Idea     @relation(fields: [ideaId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Int
  selfFunded Boolean  @default(false) // سرمایه‌گذاری روی تیم خود
  createdAt  DateTime @default(now())

  @@index([ideaId])
  @@index([userId])
}

model DueDiligenceMessage {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@index([ideaId])
}

// ---------- محصول و بازار ----------

model Product {
  id              String     @id @default(cuid())
  slug            String     @unique // نشانی /market/<slug>
  teamId          String
  team            Team       @relation(fields: [teamId], references: [id])
  trackId         String     @default("general")
  track           Track      @relation(fields: [trackId], references: [id])
  category        String     @default("") // TECH | NON_TECH (برای محور MIXED)؛ در بقیه از محور می‌آید
  deliverableUrl  String     @default("") // لینک PR/MR در محور OS یا لینک محتوا در محور تولید محتوا
  contentType     String     @default("") // نوع محتوا (فیلم، موسیقی، پادکست، …)
  osIssueId       String?
  osIssue         OsIssue?   @relation(fields: [osIssueId], references: [id])
  preExistingNote String     @default("") // اعلام کد متن‌باز یا کار پیش از مسابقه (مشمول انتقال مالکیت نیست)
  name            String
  tagline         String     @default("")
  description     String     @default("")
  demoUrl         String     @default("")
  teaserUrl       String     @default("")
  images          String     @default("[]") // JSON array of urls
  price           Int        @default(20) // ۵..۵۰
  specialName     String     @default("") // نسخهٔ ویژه برای حراج زنده
  specialDesc     String     @default("")
  specialStart    Int        @default(20)
  submittedAt     DateTime?
  // بازخورد هوش مصنوعی پس از ثبت (نمرهٔ موقت تا ارزیابی نهایی)
  aiQuality       Int? // ۰..۱۰۰
  aiNotes         String?
  aiRecheckUsed   Boolean    @default(false) // یک بار درخواست ارزیابی مجدد
  // ارزیابی نهایی هوش مصنوعی در پایان، با پارامترهای محور (track.aiRubric)
  aiFinal         Int? // ۰..۱۰۰
  aiFinalNotes    String?
  aiFinalDetail   String     @default("") // JSON: نمرهٔ هر پارامتر
  // انتشار روی بازار استودیو: "" | REQUESTED | PUBLISHING | LIVE | REJECTED
  bazaarPackage   String     @default("") // شناسهٔ بسته (package name) برای آمار بازار
  liveStatus      String     @default("")
  liveSourceUrl   String     @default("") // لینک کد/بستهٔ محصول که تیم داده
  liveRequestNote String     @default("")
  liveUrl         String     @default("") // لینک محصول منتشرشده
  liveAdminNote   String     @default("")
  liveRequestedAt DateTime?
  liveAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  purchases       Purchase[]
  hearts          Heart[]
  auction         Auction?
  juryScores      JuryScore[]
  bazaarStat      BazaarStat?

  @@unique([teamId, trackId])
  @@index([trackId])
}

// نمرهٔ مستقل هر داور برای یک محصول
model JuryScore {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  judgeId   String
  judge     User     @relation(fields: [judgeId], references: [id])
  scores    String   @default("{}") // JSON: {criterionKey: 0..10}
  note      String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([productId, judgeId])
  @@index([judgeId])
}

// آمار محصول در بازار (فعلاً ورود دستی/اکسل؛ بعداً API بازار استودیو)
model BazaarStat {
  id             String    @id @default(cuid())
  productId      String    @unique
  product        Product   @relation(fields: [productId], references: [id])
  activeInstalls Int       @default(0)
  revenueToman   Int       @default(0)
  rating         Float? // ۰..۵
  commentCount   Int       @default(0)
  source         String    @default("manual") // manual | excel | api
  flagged        Boolean   @default(false) // مشکوک به نصب/نظر جعلی: تا رفع پرچم در امتیاز حساب نمی‌شود
  flagNote       String    @default("")
  snapshotAt     DateTime? // برداشت نهایی در ددلاین
  updatedAt      DateTime  @updatedAt
}

// جوایز (مبلغ ثابت، قابل ویرایش در پنل)
model Prize {
  id              String   @id @default(cuid())
  trackId         String
  track           Track    @relation(fields: [trackId], references: [id])
  category        String   @default("") // "" = همهٔ محور | TECH | NON_TECH
  kind            String   @default("RANK") // RANK (خودکار از رتبه) | SPECIAL (انتخاب کمیته)
  rank            Int      @default(1)
  label           String
  emoji           String   @default("🏆")
  amountToman     Int? // null = هنوز نهایی نشده
  winnerProductId String? // برای جوایز ویژه
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([trackId])
}

model Purchase {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int // سکهٔ پرداختی (بعد از تخفیف)
  discount  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

model Heart {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

// ---------- حراج زنده ----------

model Auction {
  id         String    @id @default(cuid())
  productId  String    @unique
  product    Product   @relation(fields: [productId], references: [id])
  order      Int       @default(0) // ترتیب اجرا
  startPrice Int       @default(20)
  startsAt   DateTime?
  endsAt     DateTime?
  status     String    @default("SCHEDULED") // SCHEDULED | LIVE | ENDED — تیم در روز بازار محصولش را به صف حراج می‌فرستد
  winnerId   String?
  finalPrice Int?
  extensions Int       @default(0)
  bids       Bid[]

  @@index([status, order])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId, amount])
  @@index([userId])
}

// ---------- حراج جایگاه تبلیغاتی ----------

model AdSlot {
  id           String      @id @default(cuid())
  kind         String // BANNER | FEATURED | PUSH
  hourStart    DateTime // بازهٔ یک‌ساعته در روز بازار
  status       String      @default("OPEN") // OPEN | REFUNDED
  winnerTeamId String? // بالاترین پیشنهاد فعلی؛ تا شروع بازه با پیشنهاد بالاتر عوض می‌شود
  winnerProductId String?
  winnerUserId String?
  pricePaid    Int?
  bids         AdSlotBid[]

  @@unique([kind, hourStart])
}

model AdSlotBid {
  id        String   @id @default(cuid())
  slotId    String
  slot      AdSlot   @relation(fields: [slotId], references: [id])
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String
  productId String
  amount    Int
  createdAt DateTime @default(now())

  @@index([slotId, amount])
  @@index([teamId])
}

// ---------- دفتر کل، امتیاز، تنظیمات ----------

model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  teamId    String?
  wallet    String // SEED | BUY | TREASURY
  delta     Int
  reason    String // INVEST | PURCHASE | AUCTION_WIN | ADSLOT | COIN_PURCHASE | ADMIN (+ قدیمی: DIVIDEND | PENALTY | POWER_ANGEL)
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([teamId])
  @@index([reason])
}

model TeamScore {
  id              String   @id @default(cuid())
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  trackId         String   @default("general")
  track           Track    @relation(fields: [trackId], references: [id])
  productId       String?
  category        String   @default("")
  overallRank     Int      @default(0)
  ptsMarket       Float    @default(0)
  marketDetail    String   @default("{}") // JSON: امتیاز هر زیرشاخص بازار
  grossSales      Int      @default(0)
  dividendsPaid   Int      @default(0)
  netSales        Int      @default(0)
  externalCapital Int      @default(0)
  investorRoi     Float    @default(0)
  uniqueBuyers    Int      @default(0)
  hearts          Int      @default(0)
  unspentPenalty  Float    @default(0)
  ptsSales        Float    @default(0)
  ptsCapital      Float    @default(0)
  ptsRoi          Float    @default(0)
  ptsQuality      Float    @default(0)
  ptsTeaser       Float    @default(0)
  ptsCommunity    Float    @default(0)
  ptsPortfolio    Float    @default(0)
  ptsTaste        Float    @default(0)
  total           Float    @default(0)
  rank            Int      @default(0)
  selfCapital     Int      @default(0)
  quality         Float    @default(0)
  teaser          Float    @default(0)
  portfolio       Int      @default(0)
  taste           Float    @default(0)
  // ─── امتیاز سه‌معیاره ───
  memberCount     Int      @default(0)
  juryRaw         Float? // ۰..۱۰۰ میانگین سه پرسش داوری؛ null = هنوز داوری نشده
  juryAdjusted    Float    @default(0) // همان juryRaw (یا ۰)؛ تعداد اعضا در امتیاز اثری ندارد
  people          Float    @default(0) // حمایت مردمی (فرمول درجه‌دو)
  supporters      Int      @default(0)
  coinsReceived   Int      @default(0)
  ai              Float? // ۰..۱۰۰ داوری هوش مصنوعی؛ null = هنوز ارزیابی نشده
  ptsJury         Float    @default(0)
  ptsPeople       Float    @default(0)
  ptsAi           Float    @default(0)
  cheatPenalty    Int      @default(0)
  computedAt      DateTime @default(now())

  @@unique([teamId, trackId])
}

model CollusionFlag {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  otherTeamId String
  amountAB    Int
  amountBA    Int
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@index([teamId])
}

// ---------- اعلان‌ها ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String
  title     String
  body      String    @default("")
  href      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// اشتراک Web Push هر دستگاه کاربر (endpoint یکتاست)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  level     String   @default("info") // info | warning | danger
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// کلیدهای Setting:
// phase: REGISTRATION | IDEATION | SEED_ROUND | BUILD | MARKET | CLOSED  (حراج داخل روز بازار است)
// phase_ends_at: ISO
// starting_coins, support_cap, award_ai_team_id ...

// ─── گزارش کارهای ادمین ───
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // مثل phase.set، settlement.run، user.reset_password
  target    String   @default("")
  detail    String   @default("") // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// ─── نظرسنجی پایان بازی ───
model SurveyResponse {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // ۱ تا ۵
  fun       Int // ۱ تا ۵
  learned   Int // ۱ تا ۵
  comment   String   @default("")
  createdAt DateTime @default(now())
}

// ─── لیست سفید ثبت‌نام ───
// وقتی whitelist_enabled روشن است فقط ایمیل‌های این فهرست می‌توانند حساب بسازند.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String   @default("")
  lastName  String   @default("")
  phone     String?  @unique
  position  String   @default("") // سمت
  unit      String   @default("") // واحد سازمانی
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// درخواست دسترسی کسی که در لیست سفید نیست؛ با تأیید ادمین به AllowedEmail اضافه می‌شود
model AccessRequest {
  id           String    @id @default(cuid())
  email        String    @unique
  firstName    String
  lastName     String
  phone        String    @default("")
  position     String // سمت
  unit         String // واحد سازمانی
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

// ─── رأی‌گیری سرپرست تیم ───
// هر کاربر در هر لحظه فقط یک رأی دارد (در تیم فعلی‌اش) و تا انتخاب سرپرست می‌تواند آن را عوض کند
model TeamLeaderVote {
  id          String   @id @default(cuid())
  teamId      String
  voterId     String   @unique
  candidateId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teamId])
}

// ─── کد یک‌بارمصرف پیامکی ───
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  purpose    String // LOGIN | REGISTER | PROFILE
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
}

// ─── خرید سکه با پرداخت واقعی ───
// هر سکه COIN_PRICE_TOMAN تومان است؛ کل مبلغ پرداخت‌شده به صندوق جایزه اضافه می‌شود.
model CoinOrder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  coins      Int
  amountRial Int
  status     String    @default("PENDING") // PENDING | PAID | FAILED | CANCELED
  gateway    String // fake | manual | نام درگاه
  authority  String? // شناسهٔ تراکنش نزد درگاه
  refId      String? // کد پیگیری پرداخت موفق
  note       String    @default("")
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@unique([gateway, authority])
  @@index([userId, createdAt])
  @@index([status])
}
