// میدان بنیان‌گذاران تپسل — مدل داده
// SQLite برای سادگی استقرار؛ برای ~۱۰۰ کاربر کافی است.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------- کاربر و تیم ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique // موبایل ۰۹xxxxxxxxx برای ورود با کد پیامکی
  passwordHash String
  nickname     String
  role         String // مهارت اصلی (فقط برچسب پروفایل): BUILDER | STORYTELLER | DEALMAKER
  // قدرت‌های ویژه از بازی حذف شده‌اند؛ این سه ستون فقط برای سازگاری با داده‌های قدیمی مانده‌اند.
  power        String // کاربران تازه: ""
  powerUsed    Boolean  @default(false)
  shieldTeamId String?
  coffee       Int      @default(5)
  bugs         Int      @default(50)
  sleep        Int      @default(7)
  confidence   Int      @default(100)
  avatarSeed   String   @default("")
  isAdmin      Boolean  @default(false)
  department   String   @default("")
  createdAt    DateTime @default(now())

  // با هر بازنشانی رمز یا مسدودسازی یک واحد بالا می‌رود تا نشست‌های قدیمی باطل شوند
  sessionVersion Int       @default(0)
  blockedAt      DateTime?

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  seedWallet Int @default(100) // قدیمی (کیف بذر)؛ همه‌چیز حالا با یک کیف سکه است (ثبت‌نام ۰ می‌گذارد)
  buyWallet  Int @default(100) // کیف سکه (سکهٔ رایگان اولیه از starting_coins + سکهٔ خریداری‌شده)

  investments       Investment[]
  purchases         Purchase[]
  bids              Bid[]
  hearts            Heart[]
  ledger            LedgerEntry[]
  invitesSent       TeamInvite[]          @relation("inviter")
  chats             DueDiligenceMessage[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]
  surveyResponse    SurveyResponse?
  coinOrders        CoinOrder[]
}

model Team {
  id              String          @id @default(cuid())
  name            String          @unique
  slug            String          @unique
  logoSeed        String          @default("")
  treasury        Int             @default(0) // قدیمی (خزانهٔ تیم)؛ دیگر استفاده نمی‌شود
  // قدیمی: رأی‌گیری سرپرست حذف شده و همهٔ اعضا کارهای تیم را انجام می‌دهند
  leaderId        String?
  leaderElectedAt DateTime?
  // کسر امتیاز تقلب (با تأیید برگزارکننده) و توضیح آن برای تیم
  cheatPenalty    Int             @default(0)
  cheatNote       String          @default("")
  // شرکت فردی: تیم یک‌نفره‌ای که عضو تازه نمی‌پذیرد (هم‌تیم‌سازی خودکار و لینک دعوت به آن نمی‌رسند)
  solo            Boolean         @default(false)
  createdAt       DateTime        @default(now())
  members         User[]
  idea            Idea?
  product         Product?
  invites         TeamInvite[]
  adSlotBids      AdSlotBid[]
  score           TeamScore?
  flags           CollusionFlag[]
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  email     String
  inviterId String
  inviter   User     @relation("inviter", fields: [inviterId], references: [id])
  status    String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt DateTime @default(now())

  @@index([email, status])
  @@index([teamId])
}

// ---------- ایده و سرمایه‌گذاری ----------

model Idea {
  id                 String                @id @default(cuid())
  teamId             String                @unique
  team               Team                  @relation(fields: [teamId], references: [id])
  title              String
  oneLiner           String
  problem            String
  audience           String
  buildPlan          String // چه چیزی در ۴۸ ساعت ساخته می‌شود
  coverUrl           String                @default("")
  fundingCap         Int // قدیمی (هدف جذب سرمایه)؛ ایده‌های تازه ۰
  revenueShare       Int // قدیمی (درصد سود سرمایه‌گذار)؛ ایده‌های تازه ۰
  analystClarity     Int? // ۰..۱۰۰
  analystFeasibility Int?
  analystNovelty     Int?
  analystSummary     String? // متن فارسی تحلیل‌گر
  submittedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  investments        Investment[]
  chats              DueDiligenceMessage[]
}

model Investment {
  id         String   @id @default(cuid())
  ideaId     String
  idea       Idea     @relation(fields: [ideaId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Int
  selfFunded Boolean  @default(false) // سرمایه‌گذاری روی تیم خود
  createdAt  DateTime @default(now())

  @@index([ideaId])
  @@index([userId])
}

model DueDiligenceMessage {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String
  answer    String
  createdAt DateTime @default(now())
}

// ---------- محصول و بازار ----------

model Product {
  id              String     @id @default(cuid())
  teamId          String     @unique
  team            Team       @relation(fields: [teamId], references: [id])
  name            String
  tagline         String     @default("")
  description     String     @default("")
  demoUrl         String     @default("")
  teaserUrl       String     @default("")
  images          String     @default("[]") // JSON array of urls
  price           Int        @default(20) // ۵..۵۰
  specialName     String     @default("") // نسخهٔ ویژه برای حراج زنده
  specialDesc     String     @default("")
  specialStart    Int        @default(20)
  submittedAt     DateTime?
  juryQuality     Int? // قدیمی (۰..۱۰۰)
  juryTeaser      Int? // قدیمی (۰..۱۰۰)
  // داوری انسانی: سه پرسش، هر کدام ۰..۱۰
  juryWorks       Int? // آیا محصول واقعاً کار می‌کند؟
  juryValue       Int? // ارزش واقعی برای کاربر یا گروه پگاه
  juryPitch       Int? // تیزر و ارائه
  aiQuality       Int? // داوری هوش مصنوعی ۰..۱۰۰ (همیشه جدا از داور انسانی)
  aiNotes         String?
  // انتشار روی بازار استودیو: "" | REQUESTED | PUBLISHING | LIVE | REJECTED
  liveStatus      String     @default("")
  liveSourceUrl   String     @default("") // لینک کد/بستهٔ محصول که تیم داده
  liveRequestNote String     @default("")
  liveUrl         String     @default("") // لینک محصول منتشرشده
  liveAdminNote   String     @default("")
  liveRequestedAt DateTime?
  liveAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  purchases       Purchase[]
  hearts          Heart[]
  auction         Auction?
}

model Purchase {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int // سکهٔ پرداختی (بعد از تخفیف)
  discount  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model Heart {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

// ---------- حراج زنده ----------

model Auction {
  id         String    @id @default(cuid())
  productId  String    @unique
  product    Product   @relation(fields: [productId], references: [id])
  order      Int       @default(0) // ترتیب اجرا
  startPrice Int       @default(20)
  startsAt   DateTime?
  endsAt     DateTime?
  status     String    @default("SCHEDULED") // SCHEDULED | LIVE | ENDED — تیم در روز بازار محصولش را به صف حراج می‌فرستد
  winnerId   String?
  finalPrice Int?
  extensions Int       @default(0)
  bids       Bid[]

  @@index([status])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId, amount])
  @@index([userId])
}

// ---------- حراج جایگاه تبلیغاتی ----------

model AdSlot {
  id           String      @id @default(cuid())
  kind         String // BANNER | FEATURED | PUSH
  hourStart    DateTime // بازهٔ یک‌ساعته در روز بازار
  status       String      @default("OPEN") // OPEN | CLOSED
  winnerTeamId String?
  pricePaid    Int?
  bids         AdSlotBid[]

  @@unique([kind, hourStart])
}

model AdSlotBid {
  id        String   @id @default(cuid())
  slotId    String
  slot      AdSlot   @relation(fields: [slotId], references: [id])
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  amount    Int
  createdAt DateTime @default(now())

  @@unique([slotId, teamId])
}

// ---------- دفتر کل، امتیاز، تنظیمات ----------

model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  teamId    String?
  wallet    String // SEED | BUY | TREASURY
  delta     Int
  reason    String // INVEST | PURCHASE | AUCTION_WIN | ADSLOT | COIN_PURCHASE | ADMIN (+ قدیمی: DIVIDEND | PENALTY | POWER_ANGEL)
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([teamId])
  @@index([reason])
}

model TeamScore {
  id              String   @id @default(cuid())
  teamId          String   @unique
  team            Team     @relation(fields: [teamId], references: [id])
  grossSales      Int      @default(0)
  dividendsPaid   Int      @default(0)
  netSales        Int      @default(0)
  externalCapital Int      @default(0)
  investorRoi     Float    @default(0)
  uniqueBuyers    Int      @default(0)
  hearts          Int      @default(0)
  unspentPenalty  Float    @default(0)
  ptsSales        Float    @default(0)
  ptsCapital      Float    @default(0)
  ptsRoi          Float    @default(0)
  ptsQuality      Float    @default(0)
  ptsTeaser       Float    @default(0)
  ptsCommunity    Float    @default(0)
  ptsPortfolio    Float    @default(0)
  ptsTaste        Float    @default(0)
  total           Float    @default(0)
  rank            Int      @default(0)
  selfCapital     Int      @default(0)
  quality         Float    @default(0)
  teaser          Float    @default(0)
  portfolio       Int      @default(0)
  taste           Float    @default(0)
  // ─── امتیاز سه‌معیاره ───
  memberCount     Int      @default(0)
  juryRaw         Float? // ۰..۱۰۰ میانگین سه پرسش داوری؛ null = هنوز داوری نشده
  juryAdjusted    Float    @default(0) // همان juryRaw (یا ۰)؛ تعداد اعضا در امتیاز اثری ندارد
  people          Float    @default(0) // حمایت مردمی (فرمول درجه‌دو)
  supporters      Int      @default(0)
  coinsReceived   Int      @default(0)
  ai              Float? // ۰..۱۰۰ داوری هوش مصنوعی؛ null = هنوز ارزیابی نشده
  ptsJury         Float    @default(0)
  ptsPeople       Float    @default(0)
  ptsAi           Float    @default(0)
  cheatPenalty    Int      @default(0)
  computedAt      DateTime @default(now())
}

model CollusionFlag {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  otherTeamId String
  amountAB    Int
  amountBA    Int
  note        String   @default("")
  createdAt   DateTime @default(now())
}

// ---------- اعلان‌ها ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String
  title     String
  body      String    @default("")
  href      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// اشتراک Web Push هر دستگاه کاربر (endpoint یکتاست)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  level     String   @default("info") // info | warning | danger
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// کلیدهای Setting:
// phase: REGISTRATION | IDEATION | SEED_ROUND | BUILD | MARKET | CLOSED  (حراج داخل روز بازار است)
// phase_ends_at: ISO
// starting_coins, support_cap, award_ai_team_id ...

// ─── گزارش کارهای ادمین ───
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // مثل phase.set، settlement.run، user.reset_password
  target    String   @default("")
  detail    String   @default("") // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// ─── نظرسنجی پایان بازی ───
model SurveyResponse {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // ۱ تا ۵
  fun       Int // ۱ تا ۵
  learned   Int // ۱ تا ۵
  comment   String   @default("")
  createdAt DateTime @default(now())
}

// ─── لیست سفید ثبت‌نام ───
// وقتی whitelist_enabled روشن است فقط ایمیل‌های این فهرست می‌توانند حساب بسازند.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String   @default("")
  lastName  String   @default("")
  phone     String?  @unique
  position  String   @default("") // سمت
  unit      String   @default("") // واحد سازمانی
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// درخواست دسترسی کسی که در لیست سفید نیست؛ با تأیید ادمین به AllowedEmail اضافه می‌شود
model AccessRequest {
  id           String    @id @default(cuid())
  email        String    @unique
  firstName    String
  lastName     String
  phone        String    @default("")
  position     String // سمت
  unit         String // واحد سازمانی
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

// ─── رأی‌گیری سرپرست تیم ───
// هر کاربر در هر لحظه فقط یک رأی دارد (در تیم فعلی‌اش) و تا انتخاب سرپرست می‌تواند آن را عوض کند
model TeamLeaderVote {
  id          String   @id @default(cuid())
  teamId      String
  voterId     String   @unique
  candidateId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teamId])
}

// ─── کد یک‌بارمصرف پیامکی ───
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  purpose    String // LOGIN | REGISTER | PROFILE
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
}

// ─── خرید سکه با پرداخت واقعی ───
// هر سکه COIN_PRICE_TOMAN تومان است؛ کل مبلغ پرداخت‌شده به صندوق جایزه اضافه می‌شود.
model CoinOrder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  coins      Int
  amountRial Int
  status     String    @default("PENDING") // PENDING | PAID | FAILED | CANCELED
  gateway    String // fake | manual | نام درگاه
  authority  String? // شناسهٔ تراکنش نزد درگاه
  refId      String? // کد پیگیری پرداخت موفق
  note       String    @default("")
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@unique([gateway, authority])
  @@index([userId, createdAt])
  @@index([status])
}
