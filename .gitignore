# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template (no secrets, all values empty/defaults) must be tracked,
# otherwise a fresh clone and deploy/deploy.sh have nothing to copy.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
dev.db*

# local uploaded/optimized images (see src/lib/uploads.ts, UPLOAD_DIR)
/data/uploads

# خروجی‌های تست بار (کوکی‌ها = نشست معتبر؛ هرگز کامیت نشوند)
loadtest-report-*.json
loadtest-cookies*.json
*-cookies.json
