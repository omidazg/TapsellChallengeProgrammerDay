{$SITE_ADDRESS} {
	# سقف بدنهٔ درخواست: بزرگ‌ترین مصرف‌کنندهٔ مشروع server actionها هستند (bodySizeLimit=10mb در
	# next.config.ts) و آپلود تصویر (۵ مگابایت)؛ بدنه‌های بزرگ‌تر پیش از رسیدن به Node (که کل
	# بدنه را در حافظه می‌خواند) رد می‌شوند.
	request_body {
		max_size 11MB
	}

	# فایل‌های استاتیک Next.js هش‌دار هستند؛ یک سال کش می‌شوند.
	@static path /_next/static/* /brand/* /fonts/*
	header @static {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}

	# مسیرهای polling هرگز کش نشوند.
	# جریان SSE مستثناست: خود اپ «no-cache, no-transform» می‌فرستد و نباید بازنویسی شود.
	@api {
		path /api/*
		not path /api/auction/stream
	}
	header @api {
		Cache-Control "no-store"
		defer
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# HSTS فقط روی پاسخ‌های HTTPS. در حالت HTTP ساده (SITE_ADDRESS=:80) هیچ‌وقت فرستاده نمی‌شود؛
	# با دامنه، درخواست‌های :80 فقط ریدایرکت خودکار Caddy به HTTPS را می‌گیرند.
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	# CSP سراسری — با «?» فقط وقتی گذاشته می‌شود که خود اپ CSP نفرستاده باشد؛ مسیرهای
	# /covers/* و /uploads/* سیاست سخت‌گیرانهٔ خودشان را دارند (default-src 'none'; sandbox)
	# و نباید بازنویسی شوند.
	# - script-src: اسکریپت‌های inline خود Next.js و اسکریپت theme-init در layout.tsx
	#   (nonce در این راه‌اندازی نداریم) → 'unsafe-inline'.
	# - img-src: میزبان‌های remotePatterns در next.config.ts (src/lib/product-utils.ts هم
	#   مستقیم از آن‌ها استفاده می‌کند).
	# - frame-src: فقط آدرس‌هایی که parseTeaser در src/lib/product-utils.ts برای iframe
	#   می‌سازد (youtube.com/embed و aparat.com/video/video/embed) + youtube-nocookie.
	# - media-src: تیزرهای <video> فقط از خود سایت؛ لینک مستقیم ویدیو روی میزبان دیگر
	#   (parseTeaser → kind "video") در مرورگر بلاک می‌شود. برای مجاز کردن یک میزبان
	#   ویدیو، آن را همین‌جا به media-src اضافه کنید.
	# - connect-src 'self': جریان SSE در /api/auction/stream و polling ها.
	header ?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://picsum.photos https://images.unsplash.com https://tapsell.com; media-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.aparat.com; connect-src 'self'; font-src 'self' data:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	# Server-Sent Events حراج زنده: بدون encode (فشرده‌سازی بافر می‌کند)
	# و با flush فوری هر رویداد به کلاینت.
	# lb_try_duration/lb_try_interval: در حین ری‌استارت web (دیپلوی)، Caddy
	# درخواست را تا ۳۰ ثانیه نگه می‌دارد و هر ۲۵۰ میلی‌ثانیه دوباره امتحان
	# می‌کند به‌جای برگرداندن ۵۰۲ فوری (نزدیک به بدون-داون‌تایم).
	handle /api/auction/stream {
		reverse_proxy web:3000 {
			flush_interval -1
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	# بقیهٔ مسیرها: فشرده‌سازی + پروکسی عادی.
	handle {
		encode gzip zstd
		# health_uri: فقط دیتابیس (probe=db) — اسکجولرِ کند نباید Caddy را وادار کند کل سایت
		# را ۵۰۳ کند؛ آن را healthcheck داکر و uptime-check با /api/health کامل گزارش می‌کنند.
		reverse_proxy web:3000 {
			health_uri /api/health?probe=db
			health_interval 30s
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

# ریدایرکت آدرس قدیمی (IP) به دامنه، پس از ./deploy/enable-domain.sh.
# با SITE_ADDRESS=festival.pegah.tech، Caddy فقط همان نام را سرو می‌کند و لینک‌های قدیمی
# http://188.121.125.246/... هیچ پاسخی نمی‌گرفتند. enable-domain.sh این دو مقدار را در
# .env سرور می‌گذارد:
#   LEGACY_HTTP_ADDRESS=http://188.121.125.246
#   LEGACY_REDIRECT_TO=https://festival.pegah.tech
# پیش‌فرض (http://legacy.invalid) نامی است که هرگز resolve نمی‌شود، پس در حالت HTTP ساده
# (SITE_ADDRESS=:80) این بلوک بی‌اثر است و با :80 تداخلی ندارد (Caddy میزبان مشخص را
# پیش از catch-all تطبیق می‌دهد؛ http:// صریح یعنی گواهی هم درخواست نمی‌شود).
# 302 (موقت) عمداً: اگر با --rollback به HTTP روی IP برگردیم، مرورگرها ریدایرکت را کش
# نکرده‌اند.
{$LEGACY_HTTP_ADDRESS:http://legacy.invalid} {
	header -Server
	redir {$LEGACY_REDIRECT_TO:https://localhost}{uri} 302
}
